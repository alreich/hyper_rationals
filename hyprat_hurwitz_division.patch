+            self.assertFalse((b * x).divmod_left(b)[1])
+            self.assertFalse((x * b).divmod_right(b)[1])
+            a = rand_hu(rng, 6)
+            self.assertEqual(not a.divmod_left(b)[1], b.left_divides(a))
