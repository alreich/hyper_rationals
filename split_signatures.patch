+    def test_inverse_both_sides_for_invertible_elements(self):
+        for n, sg in enumerate(SIGNATURES_UP_TO_RANK_3 + SIGNATURES_RANK_4):
+            rng = random.Random(1700 + n)
+            done = 0
+            while done < FUZZ_TRIALS:
+                x = rand_signed(sg, rng)
+                if x.norm_squared() == 0:
