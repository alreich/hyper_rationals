+    "def unit_migration(xs, ys):\n",
+    "    \"Units u_0 = 1, u_1, ..., u_k = 1 with ys[i] == conj(u[i]) * xs[i] * u[i+1], or None.\"\n",
+    "    u = Hu(1)\n",
+    "    units = [u]\n",
+    "    for x, y in zip(xs, ys):\n",
+    "        try:\n",
+    "            u = (u * y).div_exact_left(x)        # solves  x * u_next == u * y\n",
+    "        except ValueError:\n",
+    "            return None\n",
+    "        if not u.is_unit():\n",
+    "            return None\n",
+    "        units.append(u)\n",
+    "    return units if units[-1] == Hu(1) else None\n",
+    "\n",
+    "units = unit_migration(secret_path, eve.factors)\n",
+    "print(\"Eve's factors are Alice's, migrated by these units:\")\n",
+    "for i, u in enumerate(units):\n",
+    "    print(f\"  u_{i} = {u}\")\n",
+    "\n",
+    "# Verify the claim directly (for a unit, the conjugate is the inverse):\n",
+    "print(all(units[i].conjugate() * x * units[i + 1] == y\n",
+    "          for i, (x, y) in enumerate(zip(secret_path, eve.factors))))"
    ],
